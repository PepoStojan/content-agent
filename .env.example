# SEO Content Maker — environment variables
# Copy to .env.local for development. Never commit .env.local or real
# secrets. See the chat log / project notes for exactly which of these
# are still needed from the product owner before Phase 1.

# --- Supabase ---------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic ----------------------------------------------------------
# Single configurable model for V1 (Architecture V1 §6) — never hardcode
# a model name in stage-specific code, read this via lib/ai/client.ts.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# --- Sentry -------------------------------------------------------------
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# --- Google OAuth ---------------------------------------------------------
# Configured in the Supabase Auth dashboard (Authentication > Providers
# > Google), not read directly by the Next.js app. Listed here for
# reference/tracking only.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=

# --- App ------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
